# Copy this file to .env and replace the example secrets and hosts.
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# MSSQL and Redis are external services and are not started by compose.yaml.
MSSQL_CONNECTION_STRING=Server=mssql.example.internal,1433;Database=HoloScoop;User Id=holoscoop;Password=replace-me;Encrypt=True;TrustServerCertificate=False
REDIS_CONNECTION_STRING=redis.example.internal:6379,password=replace-me,ssl=False
REDIS_STREAM_NAME=holoscoop:tasks

# Meilisearch requires a master key of at least 16 bytes.
MEILI_MASTER_KEY=replace-with-a-long-random-secret
MEILI_PORT=7700
