@page
@model HoloScoop.Pages.Search.IndexModel
@{
    ViewData["Title"] = "字幕搜索";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h4 mb-1">字幕搜索</h1>
        <p class="text-secondary mb-0">输入直播中出现过的关键词，结果会直接链接到对应时间。</p>
    </div>
    <form method="post" asp-page-handler="Rebuild">
        <button class="btn btn-outline-secondary" type="submit">从数据库重建索引</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<form method="get" class="card card-body mb-4">
    <div class="row g-2">
        <div class="col-md">
            <label class="visually-hidden" for="query">关键词</label>
            <input id="query" class="form-control" name="q" value="@Model.Query" placeholder="例如：重大告知" autofocus />
        </div>
        <div class="col-md-3">
            <label class="visually-hidden" for="speaker">说话人</label>
            <input id="speaker" class="form-control" name="speaker" value="@Model.Speaker" placeholder="说话人，例如：星街すいせい" />
        </div>
        <div class="col-md-2">
            <label class="visually-hidden" for="language">语言</label>
            <select id="language" class="form-select" name="language">
                <option value="">所有语言</option>
                <option value="ja" selected="@(Model.Language == "ja")">日语</option>
                <option value="en" selected="@(Model.Language == "en")">英语</option>
                <option value="zh-Hans" selected="@(Model.Language == "zh-Hans")">简体中文</option>
                <option value="zh-Hant" selected="@(Model.Language == "zh-Hant")">繁体中文</option>
            </select>
        </div>
        <div class="col-md-auto"><button class="btn btn-primary w-100" type="submit">搜索</button></div>
    </div>
</form>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.Result is { } result)
{
    <p class="text-secondary">找到约 @result.EstimatedTotalHits.GetValueOrDefault(result.Hits.Count) 条结果</p>
    @if (result.Hits.Count == 0)
    {
        <div class="empty-state">没有找到匹配字幕。</div>
    }
    else
    {
        <div class="vstack gap-3">
        @foreach (var hit in result.Hits)
        {
            <article class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                        <h2 class="h5 mb-0">@hit.Title</h2>
                        <span class="badge text-bg-light">@hit.Language · @hit.Source</span>
                    </div>
                    <p class="mb-2">@hit.Text</p>
                    <div class="d-flex align-items-center gap-3 small text-secondary">
                        @if (!string.IsNullOrWhiteSpace(hit.SpeakerName))
                        {
                            <span class="badge text-bg-primary">@hit.SpeakerName</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(hit.SpeakerLabel))
                        {
                            <span class="badge text-bg-light">@hit.SpeakerLabel</span>
                        }
                        <span>@hit.ChannelName</span>
                        @if (Model.HasLocalVideo(hit.StreamId))
                        {
                            <a asp-page="/Watch"
                               asp-route-streamId="@hit.StreamId"
                               asp-route-t="@(hit.StartMs / 1000)">▶ 本地播放 @HoloScoop.Pages.Search.IndexModel.FormatTimestamp(hit.StartMs)</a>
                            <a href="@hit.TimestampUrl" target="_blank" rel="noopener">YouTube</a>
                        }
                        else
                        {
                            <a href="@hit.TimestampUrl" target="_blank" rel="noopener">▶ YouTube @HoloScoop.Pages.Search.IndexModel.FormatTimestamp(hit.StartMs)</a>
                        }
                    </div>
                </div>
            </article>
        }
        </div>
    }
}
