@page "/Speakers/{streamId:long}"
@model HoloScoop.Pages.SpeakersModel
@{
    ViewData["Title"] = "发言人映射";
}

<div class="mb-3">
    <a class="text-decoration-none" asp-page="/Tasks/Index">← 返回任务管理</a>
</div>

<div class="mb-4">
    <h1 class="h4 mb-1">发言人映射</h1>
    <p class="text-secondary mb-0">@Model.Title</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Speakers.Count == 0)
{
    <div class="empty-state">这场直播还没有发言人分离结果。</div>
}
else
{
    @if (Model.HasLocalVideo)
    {
        <div class="card card-body mb-3">
            <div class="small text-secondary mb-2">点击下面的样本会从对应时间播放；样本结束时自动暂停。</div>
            <video id="speaker-sample-player" class="w-100" style="max-height: 18rem; background: #000" controls playsinline preload="metadata"
                   src="/api/streams/@Model.StreamId/video"></video>
        </div>
    }
    else if (Model.HasLocalAudio)
    {
        <div class="card card-body mb-3">
            <div class="small text-secondary mb-2">点击下面的样本会从对应时间播放；样本结束时自动暂停。</div>
            <audio id="speaker-sample-player" class="w-100" controls preload="metadata"
                   src="/api/streams/@Model.StreamId/audio"></audio>
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3">
            <span>本地没有可播放的视频或音频；之前删除的试听音频无法直接恢复。</span>
            @if (Model.CanRestorePlaybackAudio)
            {
                <form method="post" asp-page-handler="RestoreAudio" class="m-0">
                    <input type="hidden" name="streamId" value="@Model.StreamId" />
                    <button class="btn btn-sm btn-warning text-nowrap" type="submit">重新处理并补回音频</button>
                </form>
            }
        </div>
    }
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>标签</th><th>发言段</th><th>已归属字幕</th><th style="min-width: 24rem">试听样本</th><th>成员姓名</th></tr>
            </thead>
            <tbody>
            @foreach (var speaker in Model.Speakers)
            {
                <tr>
                    <td><code>@speaker.Label</code></td>
                    <td>@speaker.TurnCount</td>
                    <td>@speaker.SubtitleCount</td>
                    <td>
                        <div class="vstack gap-2">
                            @foreach (var sample in speaker.Samples)
                            {
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-primary speaker-sample"
                                            disabled="@(!Model.HasPlayableMedia)"
                                            data-start="@(sample.StartMs / 1000d)"
                                            data-end="@(sample.EndMs / 1000d)">
                                        ▶ @SpeakersModel.FormatTime(sample.StartMs)
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(sample.Text))
                                    {
                                        <span class="small ms-2">@sample.Text</span>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Map" class="d-flex align-items-start gap-2">
                            <input type="hidden" name="streamId" value="@Model.StreamId" />
                            <input type="hidden" name="label" value="@speaker.Label" />
                            <div class="flex-grow-1">
                                <input class="form-control speaker-name-input" name="name" value="@(speaker.Name ?? speaker.SuggestedName)"
                                       list="speaker-name-options" maxlength="256" autocomplete="off"
                                       placeholder="输入或选择主播名" />
                                @if (speaker.Name is null && speaker.SuggestedName is not null)
                                {
                                    <div class="form-text">
                                        声纹建议：@speaker.SuggestedName
                                        @if (speaker.SuggestedScore is not null)
                                        {
                                            <span>（相似度 @speaker.SuggestedScore.Value.ToString("P1")）</span>
                                        }
                                        ，保存后才会作为确认姓名写入字幕。
                                    </div>
                                }
                            </div>
                            <button class="btn btn-primary text-nowrap" type="submit">保存</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <datalist id="speaker-name-options">
        @foreach (var name in Model.SpeakerNames)
        {
            <option value="@name"></option>
        }
    </datalist>
}

@section Scripts {
    <script>
        (() => {
            const canonicalNames = new Map(
                Array.from(document.querySelectorAll('#speaker-name-options option'))
                    .map(option => [option.value.toLocaleLowerCase(), option.value]));
            document.querySelectorAll('.speaker-name-input').forEach(input => {
                const validate = () => {
                    const name = input.value.trim();
                    const canonicalName = canonicalNames.get(name.toLocaleLowerCase());
                    input.setCustomValidity(
                        name === '' || canonicalName
                            ? ''
                            : '该主播名不在数据库名单中，请从提示列表中选择。');
                    return canonicalName;
                };
                input.addEventListener('input', validate);
                input.addEventListener('change', () => {
                    const canonicalName = validate();
                    if (canonicalName) input.value = canonicalName;
                });
                validate();
            });

            const player = document.getElementById('speaker-sample-player');
            if (!player) return;

            let stopAt = null;
            let activeSample = 0;

            const stopIfReached = token => {
                if (token === activeSample && stopAt !== null && player.currentTime >= stopAt - 0.05) {
                    player.pause();
                    stopAt = null;
                    return true;
                }
                return false;
            };

            const monitorFrames = token => {
                if (token !== activeSample || stopAt === null || stopIfReached(token)) return;
                if ('requestVideoFrameCallback' in player) {
                    player.requestVideoFrameCallback(() => monitorFrames(token));
                } else {
                    requestAnimationFrame(() => monitorFrames(token));
                }
            };

            player.addEventListener('timeupdate', () => stopIfReached(activeSample));
            window.setInterval(() => stopIfReached(activeSample), 100);

            document.querySelectorAll('.speaker-sample').forEach(button => {
                button.addEventListener('click', async () => {
                    const start = Number(button.dataset.start);
                    const end = Number(button.dataset.end);
                    if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start) return;

                    const token = ++activeSample;

                    const beginPlayback = () => {
                        if (token !== activeSample) return;
                        player.pause();
                        player.currentTime = start;
                        stopAt = end;
                        player.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        player.play()
                            .then(() => monitorFrames(token))
                            .catch(() => { if (token === activeSample) stopAt = null; });
                    };

                    if (player.readyState >= HTMLMediaElement.HAVE_METADATA) {
                        beginPlayback();
                    } else {
                        player.addEventListener('loadedmetadata', beginPlayback, { once: true });
                        player.load();
                    }
                });
            });
        })();
    </script>
}
