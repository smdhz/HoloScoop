@page
@model HoloScoop.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = "任务管理";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 mb-1">任务管理</h1>
        <p class="text-secondary mb-0">候选任务只有在人工选择后才会开始处理。</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Tasks/Index">刷新</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<section class="card card-body mb-4">
    <h2 class="h5">手动添加任务</h2>
    <form method="get" class="row g-2">
        <div class="col-md">
            <label class="visually-hidden" for="member">主播名称</label>
            <input id="member" class="form-control" name="member" value="@Model.MemberQuery" placeholder="输入主播名称" />
        </div>
        <div class="col-md-auto">
            <button class="btn btn-outline-primary w-100" type="submit">检索 active 日程</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.MemberQuery))
    {
        @if (Model.ScheduleResults.Count == 0)
        {
            <p class="text-secondary mt-3 mb-0">没有找到匹配的 active 日程。</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>时间</th><th>主播</th><th>直播</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var schedule in Model.ScheduleResults)
                    {
                        <tr>
                            <td class="text-nowrap">@schedule.StartDt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@schedule.MemberName</td>
                            <td><a href="@schedule.StreamUrl" target="_blank" rel="noopener">@schedule.StreamTitle</a></td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="AddManual">
                                    <input type="hidden" name="scheduleId" value="@schedule.Id" />
                                    <input type="hidden" name="member" value="@Model.MemberQuery" />
                                    <button class="btn btn-sm btn-primary" type="submit">添加</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<h2 class="h5">等待选择 <span class="badge text-bg-primary">@Model.Candidates.Count</span></h2>
@if (Model.Candidates.Count == 0)
{
    <div class="empty-state mb-5">当前没有等待选择的候选任务。</div>
}
else
{
    <div class="row g-3 mb-5">
        @foreach (var task in Model.Candidates)
        {
            <div class="col-12 col-xl-6">
                <article class="card h-100">
                    <div class="card-body">
                        <div class="d-flex gap-3">
                            @if (!string.IsNullOrWhiteSpace(task.Stream.ThumbnailUrl))
                            {
                                <img class="task-thumbnail" src="@task.Stream.ThumbnailUrl" alt="" loading="lazy" />
                            }
                            <div class="min-width-0">
                                <h3 class="h5 text-break">@task.Stream.Title</h3>
                                <div class="text-secondary small">@task.Stream.ChannelName · @task.Stream.ExternalId</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form method="post" asp-page-handler="Select" class="task-selection-form">
                            <input type="hidden" name="id" value="@task.Id" />
                            <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(task.RowVersion)" />
                            <div class="task-speaker-options" role="group" aria-labelledby="speaker-label-@task.Id">
                                <span id="speaker-label-@task.Id" class="small text-secondary text-nowrap">发言人：</span>
                                <div class="form-check mb-0 text-nowrap">
                                    <input class="form-check-input" type="radio" name="speakerChoice" id="single-@task.Id" value="single" required />
                                    <label class="form-check-label" for="single-@task.Id">只有一个人</label>
                                </div>
                                <div class="form-check mb-0 text-nowrap">
                                    <input class="form-check-input" type="radio" name="speakerChoice" id="multiple-@task.Id" value="multiple" required />
                                    <label class="form-check-label" for="multiple-@task.Id">多人</label>
                                </div>
                                <input class="form-control form-control-sm task-speaker-count" type="number"
                                       name="multipleSpeakerCount" min="2" max="20" inputmode="numeric"
                                       aria-label="多人直播的发言人数" placeholder="人数" />
                            </div>
                            <div class="task-selection-actions">
                                <button class="btn btn-primary text-nowrap" type="submit" name="mode" value="VideoAndSubtitles">下载视频和字幕</button>
                                <button class="btn btn-outline-primary text-nowrap" type="submit" name="mode" value="VideoOnly" formnovalidate>仅下载视频</button>
                                <button class="btn btn-outline-secondary text-nowrap" type="submit" name="mode" value="SubtitlesOnly">仅下载字幕</button>
                                <a class="btn btn-link task-source-link" href="@task.Stream.SourceUrl" target="_blank" rel="noopener">查看来源</a>
                            </div>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
}

<h2 class="h5">最近任务</h2>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>直播</th><th>模式</th><th>状态</th><th>尝试</th><th>更新时间</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var task in Model.RecentTasks)
        {
            <tr>
                <td>
                    @if (Model.HasLocalVideo(task.StreamId))
                    {
                        <a asp-page="/Watch" asp-route-streamId="@task.StreamId">@task.Stream.Title</a>
                    }
                    else
                    {
                        <a href="@task.Stream.SourceUrl" target="_blank" rel="noopener">@task.Stream.Title</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(task.LastError))
                    {
                        <div class="small text-danger text-break">@task.LastError</div>
                    }
                </td>
                <td>@task.DownloadMode</td>
                <td><span class="badge text-bg-secondary">@task.Status</span></td>
                <td>@task.AttemptCount</td>
                <td>@task.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (task.Status == HoloScoop.Data.Entities.TaskStatus.Failed)
                    {
                        <form method="post" asp-page-handler="Retry">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">重试</button>
                        </form>
                    }
                    else if (task.Status == HoloScoop.Data.Entities.TaskStatus.Completed)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="/Speakers"
                           asp-route-streamId="@task.StreamId">发言人</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
