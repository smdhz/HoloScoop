@page "/Watch/{streamId:long}"
@model HoloScoop.Pages.WatchModel
@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.plyr.io/3.8.4/plyr.css" />
}

<div class="mb-3">
    <a class="text-decoration-none" asp-page="/Search/Index">← 返回字幕搜索</a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 mb-1">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.ChannelName))
        {
            <div class="text-secondary">@Model.ChannelName</div>
        }
    </div>
    <a class="btn btn-outline-secondary" href="@Model.SourceUrl" target="_blank" rel="noopener">在 YouTube 查看</a>
</div>

@if (Model.HasLocalVideo)
{
    <video id="player"
           class="w-100"
           controls
           playsinline
           preload="metadata"
           data-start-seconds="@Model.StartSeconds">
        <source src="/api/streams/@Model.StreamId/video" type="@Model.VideoContentType" />
        当前浏览器无法播放这个视频格式。
    </video>
}
else
{
    <div class="alert alert-warning" role="alert">
        这个直播没有可播放的本地视频，可能只下载了字幕。
    </div>
}

@section Scripts {
    <script src="https://cdn.plyr.io/3.8.4/plyr.js"></script>
    <script>
        (() => {
            const video = document.getElementById('player');
            if (!video) return;

            const requestedTime = Number(video.dataset.startSeconds);
            if (Number.isFinite(requestedTime) && requestedTime > 0) {
                const seekToRequestedTime = () => {
                    const latestTime = Number.isFinite(video.duration)
                        ? Math.max(0, video.duration - 0.1)
                        : requestedTime;
                    video.currentTime = Math.min(requestedTime, latestTime);
                };

                if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
                    seekToRequestedTime();
                } else {
                    video.addEventListener('loadedmetadata', seekToRequestedTime, { once: true });
                }
            }

            if (window.Plyr) {
                new Plyr(video);
            }
        })();
    </script>
}
