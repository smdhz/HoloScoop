{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Redis": {
    "StreamName": "forge:calendar:add",
    "ConsumerGroup": "holoscoop",
    "BatchSize": 10
  },
  "NoteSchedule": {
    "Database": "Note"
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "IndexName": "subtitle_segments"
  },
  "Media": {
    "YtDlpPath": "yt-dlp",
    "FfmpegPath": "ffmpeg",
    "LibraryRoot": "/data/library",
    "WorkRoot": "/data/work",
    "DownloadTimeout": "02:00:00",
    "WhisperMaxContext": 64,
    "WhisperUseVad": true,
    "WhisperVadModelPath": "/opt/whisper/models/ggml-silero-v6.2.0.bin",
    "WhisperVadThreshold": 0.5,
    "WhisperVadMinSpeechDurationMs": 250,
    "WhisperVadMinSilenceDurationMs": 500,
    "WhisperVadMaxSpeechDurationSeconds": 30,
    "WhisperVadSpeechPadMs": 200,
    "WhisperVadSamplesOverlapSeconds": 0.1,
    "WhisperSuppressNonSpeechTokens": true,
    "TranscriptionTimeout": "12:00:00"
  },
  "SpeakerDiarization": {
    "Enabled": true,
    "SegmentationModelPath": "/opt/sherpa-onnx/speaker-segmentation/model.onnx",
    "EmbeddingModelPath": "/opt/sherpa-onnx/nemo_en_titanet_large.onnx",
    "NumThreads": 12,
    "VoiceMatchThreshold": 0.65,
    "VoiceMatchMinimumMargin": 0.05,
    "MinimumSpeakerDominanceRatio": 0.65,
    "MinimumDetectedSpeechMs": 1000,
    "MinimumSpeakerLeadMs": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
